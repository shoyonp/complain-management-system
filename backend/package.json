{
  "name": "diu-complaint-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for the DIU privacy-preserving student complaint management system",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nodemon index.js",
    "dev:memdb": "nodemon index.js --memdb",
    "start": "node index.js",
    "seed": "node index.js --seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "transform": {},
    "clearMocks": true,
    "testTimeout": 60000
  }
}
