# Copy this file to `.env` for local development. Never commit real secrets.
# The API validates these variables at startup and exits with a clear error
# if a required one is missing or invalid (see src/config/env.js).

# --- Required now (M0/M1) ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB. Use `npm run dev:memdb` to run without Atlas (in-memory, resets on restart).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/diu_complaints?retryWrites=true&w=majority

# Firebase Admin service account
# (Firebase console > Project settings > Service accounts > Generate new private key)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Seed script only (npm run seed) — the first admin account you control.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_NAME=System Administrator

# --- Required from M2 (privacy module) ---
# HMAC key for complaint ownerKey (pseudonymization). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PSEUDONYM_SECRET=
# 32-byte key, base64 encoded, for AES-256-GCM identity vault encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IDENTITY_ENC_KEY=

# --- Required from M7 (AI integration layer, disabled by default) ---
AI_ENABLED=false
# AI_SERVICE_URL=
# AI_SERVICE_API_KEY=
# AI_CALLBACK_SECRET=
