# Copy this file to `.env` for local development. Never commit real secrets.
# The API validates these variables at startup and exits with a clear error
# if a required one is missing or invalid (see src/config/env.js).

# --- Required now (M0) ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Required from M1 (auth) ---
# Firebase Admin service account (Firebase console > Project settings > Service accounts)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Required from M2 (database and privacy module) ---
# MongoDB Atlas connection string (least-privilege database user)
# MONGODB_URI=
# HMAC key for complaint ownerKey (pseudonymization). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PSEUDONYM_SECRET=
# 32-byte key, base64 encoded, for AES-256-GCM identity vault encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IDENTITY_ENC_KEY=

# --- Required from M7 (AI integration layer, disabled by default) ---
AI_ENABLED=false
# AI_SERVICE_URL=
# AI_SERVICE_API_KEY=
# AI_CALLBACK_SECRET=
